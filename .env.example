# Токен бота: Discord Developer Portal → Bot → Token (обязательно)
DISCORD_TOKEN=вставь_токен_сюда

# Движок синтеза: piper (локально, мгновенно) или edge (облако, качественнее)
TTS_ENGINE=piper

# Голос Edge-TTS. Женский: ru-RU-SvetlanaNeural, мужской: ru-RU-DmitryNeural
TTS_VOICE=ru-RU-SvetlanaNeural

# Темп речи: от -50% до +100%
TTS_RATE=+0%

# Громкость синтеза: от -100% до +100%
TTS_VOLUME=+0%

# Сообщения длиннее этого лимита обрезаются (с «…»)
MAX_TEXT_LENGTH=300
